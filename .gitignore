# Cached data — regenerate with `python -m study.run --force-data`
data/
*.parquet

# Results: the numbers, exhibits and trade logs ARE committed, so the note's
# figures render on GitHub and a reader can check the trades behind a claim.
# The run log is noise, and smoke output is a five-ticker development artifact
# that must never be mistaken for the study's results.
results/*.log
results/results_smoke.json

